# Browser-visible RPC endpoint; API keys in VITE_* are not secret.
VITE_MAINNET_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
# Required: explicitly set the independently verified Mainnet AMM program ID.
# VITE_MAINNET_AMM_PROGRAM_ID=

# Optional Pinata credentials, read by the local Vite server / CLI, never the browser.
PINATA_JWT=
# PINATA_API_KEY=
# PINATA_API_SECRET=
# PINATA_GATEWAY=https://gateway.pinata.cloud
