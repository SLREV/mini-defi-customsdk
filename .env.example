# Opsional — override endpoint RPC devnet yang dipakai dashboard (mode "Devnet RPC").
# RPC publik api.devnet.solana.com sering kena rate-limit; isi dengan RPC devnet milikmu.
# Salin file ini menjadi `.env` lalu isi nilainya.
VITE_RPC_ENDPOINT=https://api.devnet.solana.com

# Program ID AMM yang dipanggil dashboard & script.
# Kosongkan (atau hapus baris ini) untuk memakai default di src/sdk/customSdk.ts.
#
# ISI INI bila `anchor deploy` mencetak "Program Id:" yang BERBEDA dari
# Csre71k9LDyYGx4t2hiG6VT4wiymuhPVXeksqe6Z83Hp — biasanya karena build
# dijalankan di folder tanpa target/deploy/mini_amm-keypair.json (mis. hasil
# download ZIP), sehingga Anchor membuat keypair program baru.
# Cek dengan: npm run toolchain:check
# VITE_AMM_PROGRAM_ID=DnW4iMWC5gCjPZkk2kkdTrY5uybW3w6r6aLdS6meynMn

# ---------------------------------------------------------------------------
# Pinata (IPFS) — dipakai `npm run pinata:upload`, hanya untuk CLI/Node.
# JANGAN pakai prefix VITE_ untuk secret: semua VITE_* ikut ter-bundle ke browser.
# ---------------------------------------------------------------------------
# Pilih salah satu: JWT (disarankan) ATAU pasangan API key/secret legacy.
PINATA_JWT=
# PINATA_API_KEY=
# PINATA_API_SECRET=
# Opsional: gateway khusus (dedicated gateway) untuk URL IPFS yang dipakai metadata
# PINATA_GATEWAY=https://gateway.pinata.cloud
